# Сервер
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=one_year_invitation

# Авторизация админки
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=12
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345

# Безопасность / CORS
CLIENT_ORIGIN=http://localhost:5173
# true — только если сайт открывается по HTTPS
COOKIE_SECURE=false

# true — добавить несколько демонстрационных записей при инициализации БД
SEED_DEMO=true
