# Сервер
PORT=4000
NODE_ENV=development

# SQLite
# Путь к файлу базы данных (по умолчанию — data/invite.db в корне проекта)
DB_PATH=

# Авторизация админки
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=12
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345

# Безопасность / CORS
CLIENT_ORIGIN=http://localhost:5173
# true — только если сайт открывается по HTTPS
COOKIE_SECURE=false

# true — добавить несколько демонстрационных записей при инициализации БД
SEED_DEMO=true
