# Клиентские настройки (необязательно)

# Адрес API. По умолчанию используется /api (Vite проксирует на :4000).
# VITE_API_URL=http://localhost:4000/api

# Своя музыка вместо встроенной генеративной мелодии.
# Файл положите в client/public/audio/ и укажите путь:
# VITE_MUSIC_SRC=/audio/music.mp3

# Фото для арки в первом экране. Файл положите в client/public/images/:
# VITE_PORTRAIT_URL=/images/portrait.jpg
